# ==============================================================================
# MixSense Backend Environment Configuration
# ==============================================================================
# Copy this file to .env and configure the values for your environment
# IMPORTANT: Never commit .env file to version control
# ==============================================================================

# Environment (development | production | test)
NODE_ENV=development

# Server Configuration
PORT=5000

# Database Configuration
# Format: mysql://username:password@host:port/database_name
# Example for production: mysql://mixsense_user:secure_password@192.168.1.100:3306/mixsense_prod
DATABASE_URL="mysql://root:password@localhost:3306/mixer_db"

# JWT Authentication
# SECURITY: Change JWT_SECRET to a strong random string in production!
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=8h

# CORS Configuration
# Set this to your frontend URL (development: http://localhost:5173)
# For production: https://your-production-domain.com
CORS_ORIGIN=http://localhost:5173

# Logging
# Options: error | warn | info | http | verbose | debug | silly
LOG_LEVEL=info
