// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// User model for authentication and authorization
model User {
  id                      Int        @id @default(autoincrement())
  username                String     @unique @db.VarChar(50)
  passwordHash            String     @map("password_hash") @db.VarChar(255)
  role                    Role

  // Lifecycle tracking
  createdAt               DateTime   @default(now()) @map("created_at")
  updatedAt               DateTime   @default(now()) @updatedAt @map("updated_at")
  updatedByUserId         Int?       @map("updated_by_user_id")
  deletedAt               DateTime?  @map("deleted_at")
  deletedByUserId         Int?       @map("deleted_by_user_id")

  // Security tracking
  passwordChangedAt       DateTime?  @map("password_changed_at")
  passwordChangedByUserId Int?       @map("password_changed_by_user_id")
  lastLoginAt             DateTime?  @map("last_login_at")

  // Relations - Materials
  materials          Material[] @relation("CreatedMaterials")
  updatedMaterials   Material[] @relation("UpdatedMaterials")
  deletedMaterials   Material[] @relation("DeletedMaterials")

  // Relations - Recipes
  recipes            Recipe[]   @relation("CreatedRecipes")
  updatedRecipes     Recipe[]   @relation("UpdatedRecipes")
  deletedRecipes     Recipe[]   @relation("DeletedRecipes")

  // Relations - Batches
  batches            Batch[]    @relation("OperatorBatches")
  processRecipeLogs  BatchLog[] @relation("ProcessRecipeUser")

  // Self-referential relations for user management
  updatedBy          User?      @relation("UserUpdates", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  updatedUsers       User[]     @relation("UserUpdates")
  deletedBy          User?      @relation("UserDeletes", fields: [deletedByUserId], references: [id], onDelete: SetNull)
  deletedUsers       User[]     @relation("UserDeletes")
  passwordChangedBy  User?      @relation("PasswordChanges", fields: [passwordChangedByUserId], references: [id], onDelete: SetNull)
  passwordChangesFor User[]     @relation("PasswordChanges")

  @@index([updatedByUserId])
  @@index([deletedByUserId])
  @@index([deletedAt])
  @@index([passwordChangedByUserId])
  @@map("users")
}

enum Role {
  ADMIN
  OPERATOR
}

// Material model for ingredients only
model Material {
  id               Int           @id @default(autoincrement())
  name             String        @db.VarChar(100)
  code             String        @unique @db.VarChar(50)
  createdByUserId  Int           @map("created_by_user_id")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @default(now()) @updatedAt @map("updated_at")
  updatedByUserId  Int?          @map("updated_by_user_id")
  deletedAt        DateTime?     @map("deleted_at")
  deletedByUserId  Int?          @map("deleted_by_user_id")

  // Relations
  createdBy        User          @relation("CreatedMaterials", fields: [createdByUserId], references: [id])
  updatedBy        User?         @relation("UpdatedMaterials", fields: [updatedByUserId], references: [id])
  deletedBy        User?         @relation("DeletedMaterials", fields: [deletedByUserId], references: [id])
  recipeSteps      RecipeStep[]  @relation("StepMaterial")
  batchLogs        BatchLog[]

  @@index([createdByUserId])
  @@index([updatedByUserId])
  @@index([deletedByUserId])
  @@index([deletedAt])
  @@map("materials")
}

// Recipe model for defining mixing procedures
model Recipe {
  id               Int           @id @default(autoincrement())
  name             String        @db.VarChar(100)
  createdByUserId  Int           @map("created_by_user_id")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @default(now()) @updatedAt @map("updated_at")
  updatedByUserId  Int?          @map("updated_by_user_id")
  deletedAt        DateTime?     @map("deleted_at")
  deletedByUserId  Int?          @map("deleted_by_user_id")

  // Relations
  createdBy        User          @relation("CreatedRecipes", fields: [createdByUserId], references: [id])
  updatedBy        User?         @relation("UpdatedRecipes", fields: [updatedByUserId], references: [id])
  deletedBy        User?         @relation("DeletedRecipes", fields: [deletedByUserId], references: [id])
  steps            RecipeStep[]
  batches          Batch[]

  @@index([createdByUserId])
  @@index([updatedByUserId])
  @@index([deletedByUserId])
  @@index([deletedAt])
  @@map("recipes")
}

// RecipeStep model for individual steps in a recipe
model RecipeStep {
  id                Int           @id @default(autoincrement())
  recipeId          Int           @map("recipe_id")
  materialId        Int           @map("material_id")
  stepOrder         Int           @map("step_order")
  setpoint          Decimal       @db.Decimal(10, 3)
  tolerancePercent  Decimal       @map("tolerance_percent") @db.Decimal(5, 2)

  // Relations
  recipe            Recipe        @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  material          Material      @relation("StepMaterial", fields: [materialId], references: [id])
  batchLogs         BatchLog[]

  @@index([recipeId])
  @@index([materialId])
  @@map("recipe_steps")
}

// Batch model for tracking batch execution
model Batch {
  id               Int           @id @default(autoincrement())
  recipeId         Int           @map("recipe_id")
  operatorUserId   Int           @map("operator_user_id")
  startTime        DateTime      @map("start_time")
  endTime          DateTime?     @map("end_time")
  status           BatchStatus

  // Relations
  recipe           Recipe        @relation(fields: [recipeId], references: [id])
  operator         User          @relation("OperatorBatches", fields: [operatorUserId], references: [id])
  logs             BatchLog[]

  @@index([recipeId])
  @@index([operatorUserId])
  @@index([status])
  @@map("batches")
}

enum BatchStatus {
  IN_PROGRESS
  COMPLETED
  ABORTED
  PROCESSED
}

// BatchLog model for logging each step execution
model BatchLog {
  id                      Int           @id @default(autoincrement())
  batchId                 Int           @map("batch_id")
  stepId                  Int           @map("step_id")
  materialId              Int           @map("material_id")

  // Weight Information
  actualWeight            Decimal       @map("actual_weight") @db.Decimal(10, 3)
  setpointSnapshot        Decimal       @map("setpoint_snapshot") @db.Decimal(10, 3)
  toleranceSnapshot       Decimal       @map("tolerance_snapshot") @db.Decimal(5, 2)

  // Material Code Snapshot (for historical accuracy)
  materialCodeSnapshot    String?       @map("material_code_snapshot") @db.VarChar(50)
  materialNameSnapshot    String?       @map("material_name_snapshot") @db.VarChar(100)

  // Recipe Information Snapshot
  recipeNameSnapshot      String?       @map("recipe_name_snapshot") @db.VarChar(100)
  stepOrderSnapshot       Int?          @map("step_order_snapshot")

  // Process Recipe Phase (Packet Preparation)
  processRecipeUserId     Int?          @map("process_recipe_user_id")
  processRecipeTimestamp  DateTime?     @map("process_recipe_timestamp")

  // Process Batch Phase (Packet Scanning)
  processBatchTimestamp   DateTime      @default(now()) @map("process_batch_timestamp")

  // QR Code Data (parsed fields for easy querying)
  qrCodeData              String?       @map("qr_code_data") @db.Text

  // Relations
  batch                   Batch         @relation(fields: [batchId], references: [id], onDelete: Cascade)
  step                    RecipeStep    @relation(fields: [stepId], references: [id])
  material                Material      @relation(fields: [materialId], references: [id])
  processRecipeUser       User?         @relation("ProcessRecipeUser", fields: [processRecipeUserId], references: [id], onDelete: SetNull)

  @@index([batchId])
  @@index([stepId])
  @@index([materialId])
  @@index([processRecipeUserId])
  @@index([processRecipeTimestamp])
  @@index([processBatchTimestamp])
  @@map("batch_logs")
}
