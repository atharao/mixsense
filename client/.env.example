# API URL
VITE_API_URL=http://localhost:5000/api

# MQTT Configuration (optional - defaults will be used if not set)
# IMPORTANT: Use WebSocket port (9001) not TCP port (1883) for browser connections
VITE_MQTT_HOST=localhost
VITE_MQTT_PORT=9001
VITE_MQTT_TOPIC=mixsense/weight
VITE_MQTT_PROTOCOL=ws

# ZPL Printer Service URL
VITE_ZPL_PRINTER_URL=http://localhost:9100/
