# ==============================================================================
# MixSense Frontend Environment Configuration
# ==============================================================================
# Copy this file to .env and configure the values for your environment
# IMPORTANT: Never commit .env file to version control
# ==============================================================================

# Backend API URL
# Development: http://localhost:5000/api
# Production: https://your-backend-url.com/api
VITE_API_URL=http://localhost:5000/api

# Node-RED WebSocket Configuration
# These WebSocket endpoints connect to Node-RED for real-time hardware data

# Weight Data WebSocket (Process Recipe Page)
# Receives real-time weight data every second from load cells
# Format: ws://node-red-host:port/ws/weight
VITE_WEIGHT_WS_URL=ws://localhost:1880/ws/weight

# Barcode Scanner WebSocket (Process Batch Page)
# Receives barcode scan data from QR/barcode scanners
# Format: ws://node-red-host:port/ws/barcode
VITE_BARCODE_WS_URL=ws://localhost:1880/ws/barcode

# ZPL Printer Service URL
# ZDesigner ZD421-300dpi ZPL printer endpoint
# Used for printing QR code labels during Process Recipe
# Format: http://printer-ip:port or http://print-server:port
VITE_ZPL_PRINTER_URL=http://localhost:9100

# Development Proxy Configuration (used by vite.config.ts in development mode)
# These variables configure the Vite dev server proxy targets
# Backend API proxy target (usually matches the host part of VITE_API_URL)
VITE_PROXY_API_TARGET=http://localhost:5000

# ZPL Printer proxy target (usually matches VITE_ZPL_PRINTER_URL)
VITE_PROXY_ZPL_TARGET=http://localhost:9100
